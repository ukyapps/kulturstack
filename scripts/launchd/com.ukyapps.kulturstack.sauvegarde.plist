<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sauvegarde la base de Kulturstack toutes les 30 minutes. Le script se tait et rend 0
     quand aucun iPhone n'est branché, donc la quasi-totalité des réveils ne font rien.
     Aucun secret ici : seulement un chemin de script (règle de docs/tdd/06-secrets.md).
     Installation : make sauvegarde-auto · arrêt : make sauvegarde-stop -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ukyapps.kulturstack.sauvegarde</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SCRIPT__</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>KULTURSTACK_SAUVEGARDES</key>
        <string>__SAUVEGARDES__</string>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
