    "about.openlibrary.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books come from Open Library, an Internet Archive project."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
