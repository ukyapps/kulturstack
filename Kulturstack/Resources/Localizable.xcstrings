    "privacy.leaves.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you search for a work, the text you type is sent to TMDB (films and series) and OpenLibrary (books), along with your IP address, like any web search. Posters and covers come from their servers. That’s all: no account, no usage analytics, no crash reports."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu cherches une œuvre, le texte que tu tapes est envoyé à TMDB (films et séries) et à OpenLibrary (livres), avec ton adresse IP, comme n’importe quelle recherche sur le web. Les affiches et couvertures viennent de leurs serveurs. C’est tout : pas de compte, pas de statistiques d’usage, pas de rapport de plantage."
          }
        }
      }
    },
    "privacy.leaves.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What leaves your iPhone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui sort de ton iPhone"
          }
        }
      }
    },
    "privacy.stays.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you’ve seen, read, rated, commented or saved for later never leaves your iPhone — apart from the device’s iCloud backup, handled and encrypted by Apple. “Erase everything” in Settings deletes it all, right away. Exporting your data will come with import."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tu as vu, lu, noté, commenté ou gardé en envie ne quitte jamais ton iPhone — hors sauvegarde iCloud de l’appareil, gérée et chiffrée par Apple. « Tout effacer » dans Réglages supprime tout, tout de suite. L’export de tes données arrive avec l’import."
          }
        }
      }
    },
    "privacy.stays.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays with you"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui reste chez toi"
          }
        }
      }
    },
