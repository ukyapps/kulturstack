    "journal.error.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong reading the database. Try again — if it persists, contact us."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose a coincé en lisant la base. Réessaie — si ça persiste, écris-nous."
          }
        }
      }
    },
