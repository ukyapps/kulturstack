    "journal.empty.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for a film, a series or a book and tap it: it’s logged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche un film, une série ou un livre et tape dessus : c’est loggé."
